{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/freeinsider/data-layer-events.schema.json",
  "title": "FreeInsider dataLayer ecommerce events",
  "description": "Suggested shapes for GTM; align with your GA4 / Enhanced Ecommerce mapping.",
  "type": "object",
  "oneOf": [
    {
      "title": "spa_page_view",
      "properties": {
        "event": { "const": "spa_page_view" },
        "page_path": { "type": "string" },
        "page_type": { "type": "string" },
        "locale": { "type": "string" }
      },
      "required": ["event", "page_path"]
    },
    {
      "title": "view_item",
      "properties": {
        "event": { "const": "view_item" },
        "ecommerce": {
          "type": "object",
          "properties": {
            "currency": { "type": "string" },
            "value": { "type": "number" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "item_id": { "type": "string" },
                  "item_name": { "type": "string" },
                  "item_category": { "type": "string" },
                  "price": { "type": "number" },
                  "quantity": { "type": "number" }
                },
                "required": ["item_id"]
              }
            }
          }
        }
      },
      "required": ["event", "ecommerce"]
    },
    {
      "title": "add_to_cart",
      "properties": {
        "event": { "const": "add_to_cart" },
        "ecommerce": { "type": "object" }
      },
      "required": ["event"]
    }
  ]
}
